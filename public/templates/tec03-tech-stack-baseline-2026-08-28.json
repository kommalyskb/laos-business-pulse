{
  "document": {
    "id": "TEC-03",
    "version": "1.0",
    "status": "approved",
    "createdAt": "2026-08-28",
    "updatedAt": "2026-08-30",
    "asOf": "2026-08-30",
    "owner": "Solution Architect / Tech Lead",
    "approver": "Product Owner"
  },
  "architecture": {
    "style": "modular_monolith_first",
    "repository": "pnpm_workspace_single_repository",
    "deployables": ["web_and_api", "background_worker"],
    "sourceOfTruth": "postgresql",
    "externalMedia": "link_only",
    "aiInMvp": false
  },
  "stack": [
    { "id": "TS-01", "layer": "language", "choice": "TypeScript", "baseline": "5.x", "pin": "exact_minor_patch_in_lockfile" },
    { "id": "TS-02", "layer": "web_application", "choice": "Next.js and React", "baseline": "Next.js 16.x Active LTS; React 19", "pin": "exact_patch" },
    { "id": "TS-03", "layer": "runtime", "choice": "Node.js", "baseline": "24 LTS", "pin": "major_24_and_exact_container_digest" },
    { "id": "TS-04", "layer": "primary_database", "choice": "PostgreSQL", "baseline": "18", "pin": "managed_supported_minor" },
    { "id": "TS-05", "layer": "data_access", "choice": "Drizzle ORM and reviewed SQL migrations", "baseline": "latest_tested_supported", "productionGuardrail": "no_schema_push" },
    { "id": "TS-06", "layer": "search", "choice": "PostgreSQL normalized fields, pg_trgm and indexes", "baseline": "pilot", "escalation": "TEC-05_evidence" },
    { "id": "TS-07", "layer": "background_jobs", "choice": "Graphile Worker and transactional outbox", "delivery": "at_least_once", "guardrail": "idempotent_tasks_bounded_retry_dead_job_alert" },
    { "id": "TS-08", "layer": "object_storage", "choice": "Cloudflare R2 through S3-compatible adapter", "guardrail": "private_by_default_social_video_link_only" },
    { "id": "TS-09", "layer": "identity", "choice": "Managed OIDC provider and server session", "status": "provider_pending_TEC-06" },
    { "id": "TS-10", "layer": "testing", "choice": "Vitest and Playwright", "coverage": ["unit", "integration", "contract", "e2e", "accessibility_journeys"] },
    { "id": "TS-11", "layer": "application_telemetry", "choice": "Pino structured JSON logger and OpenTelemetry SDK", "signals": ["logs", "metrics", "traces"], "guardrail": "allowlist_redaction_no_secret_token_or_full_PII" },
    { "id": "TS-12", "layer": "telemetry_pipeline", "choice": "Grafana Alloy on OVH to OTLP to Grafana Cloud", "guardrail": "bounded_buffer_asynchronous_fail_open_and_external_missing_data_alert" },
    { "id": "TS-13", "layer": "observability_backend", "choice": "Grafana Cloud Loki, Mimir, Tempo and Grafana Alerting", "guardrail": "quote_retention_ingest_limit_and_cost_alert_required" },
    { "id": "TS-14", "layer": "security_event_monitoring", "choice": "normalized security events and restricted Grafana dashboards and alerts", "guardrail": "separate_from_application_and_audit_logs" },
    { "id": "TS-15", "layer": "siem_evolution", "choice": "managed SIEM pending risk, compliance or scale trigger", "guardrail": "do_not_claim_full_SIEM_during_Pilot" },
    { "id": "TS-16", "layer": "delivery", "choice": "GitHub Actions, Docker OCI image, Docker Compose and Caddy on OVH", "guardrail": "digest_pinning_separate_migration_approved_deploy_and_rollback_manifest" }
  ],
  "containers": {
    "pilotDecision": "single_host_Docker_Compose_without_Kubernetes_or_Swarm",
    "runtime": {
      "engine": "Docker Engine CE stable from the official Docker Debian repository",
      "components": ["docker-ce", "docker-ce-cli", "containerd.io", "runc"],
      "hostOperatingSystem": "Debian 13 Trixie",
      "versionPolicy": "pin the tested package versions and upgrade through CI and staging"
    },
    "orchestration": {
      "tool": "Docker Compose v2 plugin",
      "manifests": ["compose.yaml", "compose.production.yaml"],
      "excluded": ["Docker Desktop", "Compose standalone v1", "Kubernetes", "Docker Swarm"]
    },
    "buildAndRegistry": {
      "build": "multi-stage Dockerfile with BuildKit and buildx",
      "runtimeUser": "non-root",
      "registry": "GitHub Container Registry",
      "imageIdentity": "immutable commit SHA tag and OCI digest",
      "productionPull": "digest_only_never_latest",
      "evidence": ["image_scan", "SBOM", "provenance", "commit_digest_mapping"]
    },
    "services": [
      { "name": "caddy", "role": "HTTPS edge and reverse proxy", "publicPorts": [80, 443] },
      { "name": "web-a", "role": "Next.js Web and API replica", "publicPorts": [] },
      { "name": "web-b", "role": "Next.js Web and API replica", "publicPorts": [] },
      { "name": "worker", "role": "Graphile Worker", "publicPorts": [] },
      { "name": "postgres", "role": "PostgreSQL 18 source of truth", "publicPorts": [] },
      { "name": "alloy", "role": "host container application and database telemetry collector", "publicPorts": [] },
      { "name": "migration", "role": "one-shot reviewed schema migration", "publicPorts": [] },
      { "name": "backup_restore", "role": "one-shot backup restore and recovery verification", "publicPorts": [] }
    ],
    "networks": [
      { "name": "edge", "members": ["caddy"], "rule": "only public container boundary" },
      { "name": "app", "members": ["caddy", "web-a", "web-b"], "rule": "internal HTTP and health checks" },
      { "name": "backend", "members": ["web-a", "web-b", "worker", "postgres"], "rule": "private application and database traffic" },
      { "name": "observability", "members": ["alloy", "approved telemetry endpoints"], "rule": "telemetry only with bounded credentials" }
    ],
    "storage": {
      "postgres_data": "named local volume on verified RAID1; never removed by routine deploy",
      "caddy_data_and_config": "named volumes; configuration backed up and TLS state rebuildable",
      "alloy_buffer": "bounded quota and rotation; not authoritative",
      "application_media": "Cloudflare R2; no durable media in web or worker containers",
      "postgresql_recovery": "encrypted off-host base backup and continuous WAL archive with restore drill"
    },
    "secretsAndPrivileges": {
      "source": "root-owned files outside repository and image",
      "mount": "read-only under /run/secrets only for the required service",
      "forbidden": ["privileged container", "host network or PID namespace", "writable Docker socket", "application process running as root"],
      "required": ["no-new-privileges", "read-only filesystem where possible", "minimum telemetry permissions"]
    },
    "firewall": {
      "implementation": "iptables-nft and DOCKER-USER chain",
      "policy": "default-deny forwarded traffic and publish only Caddy 80 and 443",
      "verification": "external port scan before public launch",
      "warning": "do not rely on UFW alone for Docker-published ports"
    },
    "deploymentSequence": [
      "CI lint typecheck tests migration dependency secret and image scans",
      "BuildKit builds image and GHCR records SHA tag digest SBOM and provenance",
      "restricted deploy user pulls the approved digest and validates Compose Caddy disk backup and health",
      "one-shot migration runs after backup and records evidence",
      "web replicas roll one at a time followed by the worker",
      "smoke and synthetic checks pass or the previous digest and Compose manifest are restored"
    ],
    "rollback": {
      "application": "previous OCI digest and versioned Compose manifest",
      "database": "migration-specific rollback or restore plan; never assume image rollback reverses schema",
      "evidence": "release record links commit digest migration version checks and outcome"
    }
  },
  "hosting": {
    "recommended": {
      "provider": "OVHcloud",
      "region": "Asia Pacific Singapore ap-southeast-sgp",
      "assetStatus": "existing_dedicated_server",
      "operatingSystem": "Debian 13 Trixie",
      "topology": ["Caddy", "Docker Compose web API", "Docker Compose worker", "PostgreSQL 18", "Grafana Alloy"],
      "reason": "sufficient_existing_capacity_near_Lao_users_and_lower_incremental_cash_cost",
      "approvalCondition": "OVH_G01_to_G06_pass_before_public_Pilot"
    },
    "hardware": {
      "cpu": "AMD EPYC 7313 16 cores 32 threads 3.0 to 3.7 GHz",
      "memory": "128 GB ECC DDR4 3200 MHz",
      "dataDisks": "2 x 960 GB NVMe SSD",
      "requiredDiskMode": "RAID1",
      "estimatedUsableBeforeFilesystemOverhead": "approximately 960 GB"
    },
    "initialResourceControls": {
      "hostReserve": "at least 25 percent CPU and 16 GB RAM",
      "postgresql": "start 4 to 8 vCPU and 32 to 48 GB RAM limit",
      "webApi": "start 2 replicas each 2 vCPU and 4 GB RAM",
      "worker": "start 1 to 2 replicas total 2 to 4 vCPU and 4 to 8 GB RAM",
      "disk": "keep at least 20 percent free with 70 80 90 percent alerts and log image temp quotas"
    },
    "launchGates": [
      "OVH-G01 RAID1 NVMe health filesystem and disk-full evidence",
      "OVH-G02 encrypted off-host base backup continuous WAL and monthly restore drill",
      "OVH-G03 default-deny firewall HTTPS-only public service and key-only restricted SSH",
      "OVH-G04 pinned image separate migration health check rollback and external secret",
      "OVH-G05 external uptime host RAID disk backup database queue and missing-telemetry alerts",
      "OVH-G06 PRO-04 load and latency test from Lao or Southeast Asia network"
    ],
    "primaryFallback": { "provider": "Render", "region": "Singapore", "condition": "recovery_SLO_capacity_security_or_founder_operations_gate_fails" },
    "secondaryAlternative": { "provider": "Fly.io", "region": "Singapore" }
  },
  "search": {
    "steps": ["unicode_normalize_and_alias", "published_filters", "exact_and_prefix", "trigram_candidates", "rule_based_rank", "measure_with_lao_query_set"],
    "warning": "pg_trgm_is_candidate_retrieval_not_proof_of_Lao_relevance",
    "dedicatedEngine": "not_in_pilot_without_TEC-05_trigger"
  },
  "jobs": {
    "pattern": "business_write_audit_outbox_in_one_transaction_then_worker",
    "delivery": "at_least_once",
    "requiredControls": ["idempotency_key", "bounded_retry", "dead_job_alert", "manual_replay", "correlation_id"]
  },
  "observability": {
    "pilotBackend": "Grafana Cloud",
    "signals": ["structured_logs", "metrics", "distributed_traces", "synthetic_checks"],
    "flow": "browser_web_api_worker_postgresql_debian_docker_and_NVMe_to_Pino_OpenTelemetry_and_host_integrations_to_local_Grafana_Alloy_to_OTLP_to_Grafana_Cloud_to_dashboard_alert_and_runbook",
    "collector": "Grafana_Alloy_required_on_OVH_Pilot",
    "externalMissingDataDetection": true,
    "requiredCorrelation": ["event_id", "timestamp", "environment", "service", "request_id", "trace_id", "job_id_when_applicable", "outcome", "safe_error_code", "duration_ms_when_applicable"],
    "neverLog": ["password", "session_access_or_refresh_token", "API_key", "authorization_header", "database_connection_string", "full_payment_or_evidence_file", "raw_form_body", "unnecessary_full_phone_or_email"],
    "dashboards": ["guest_API_health", "admin_operations", "worker_and_outbox", "database_and_infrastructure", "external_dependencies", "business_operations", "security_monitoring"],
    "alertRequirements": ["condition_and_window", "deduplication", "severity", "owner", "dashboard_trace_or_log_link", "runbook", "acknowledgement", "escalation"]
  },
  "securityMonitoring": {
    "pilotDecision": "SIEM_ready_security_event_monitoring_not_full_SIEM",
    "logClasses": {
      "application": "debug_and_performance_may_be_sampled_short_retention",
      "audit": "business_change_evidence_atomic_append_only_no_sampling",
      "security": "normalized_restricted_detection_and_longer_retention"
    },
    "detections": ["authentication_attack", "privilege_change", "authorization_abuse", "sensitive_evidence_access", "bulk_data_movement", "audit_or_monitoring_tamper", "configuration_or_secret_change", "data_integrity_anomaly"],
    "managedSiemTriggers": ["payment_or_booking_scope", "regulatory_or_contractual_requirement", "dedicated_security_operations_owner", "cross_source_volume_or_correlation_need", "material_security_incident"],
    "finalConfigurationOwner": "TEC-06"
  },
  "qualityGates": ["lint_and_typecheck", "domain_unit_tests", "migration_and_transaction_tests", "playwright_must_journeys", "performance_security_restore_and_manual_accessibility", "dependency_image_and_secret_scan"],
  "cost": {
